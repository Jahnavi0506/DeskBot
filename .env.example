# DRL Coding Agent - Environment Configuration Template
# Copy this file to .env and fill in your credentials:

# --- Email / SMTP Settings ---
# For Gmail:
#   1. Go to https://myaccount.google.com/security
#   2. Turn ON 2-Step Verification
#   3. Search for "App Passwords" -> Create one with name "DRL Agent"
#   4. Paste your email and the 16-character App Password below:

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Optional Overrides (Leave commented for auto-detection) ---
# DRL_MODEL=drl-coder
# DRL_DESKTOP=C:\Users\<YourUsername>\Desktop
